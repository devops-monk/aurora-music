{
  "name": "aurora-music",
  "productName": "Aurora Music",
  "version": "0.1.0",
  "description": "An Apple Music-style YouTube Music client for macOS, Windows and Linux.",
  "main": "./out/main/index.js",
  "author": "Abhay Pratap Singh",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/devops-monk/aurora-music",
  "repository": "github:devops-monk/aurora-music",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json",
    "test": "vitest run",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "build:mobile": "vite build -c vite.mobile.config.ts",
    "build:android": "npm run build:mobile && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "hls.js": "^1.7.3",
    "music-metadata": "^11.16.1",
    "ws": "^8.22.0",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "buffer": "^6.0.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "framer-motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  }
}
